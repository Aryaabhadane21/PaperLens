# PaperLens Environment Variables
PORT=5001
NODE_ENV=development

# Gemini API configuration
# Set your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=
# Model name to use (defaults to gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Mock LLM mode (set to true to test without calling Gemini API)
# Defaults to true if GEMINI_API_KEY is missing
LLM_MOCK=false

# Allowed Client Origin (for CORS in development)
CLIENT_URL=http://localhost:5173
